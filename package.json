{
  "name": "fears-foundation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Fears Foundation - biography & scholarship portfolio platform for Dr. Constance Y. Fears, JD, PhD",
  "scripts": {
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/app.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --format=iife --target=es2019 --loader:.jsx=jsx --jsx=automatic --minify --outfile=dist/app.js",
    "build": "npm run build:css && npm run build:js && npm run build:preview",
    "build:preview": "node ./scripts/bundle-preview.mjs",
    "watch:css": "tailwindcss -i ./src/index.css -o ./dist/app.css --watch",
    "watch:js": "esbuild src/main.jsx --bundle --format=iife --target=es2019 --loader:.jsx=jsx --jsx=automatic --outfile=dist/app.js --watch",
    "serve": "node ./scripts/serve.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "tailwindcss": "^3.4.13"
  }
}
